# ============================================================================
# QWEN IMAGE ANALYSER - ENVIRONMENT CONFIGURATION
# Hybrid OCR + LLM System with 98%/95%/93% Accuracy Targets
# ============================================================================
# Copy this file to .env and customize for your environment

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------
PORT=3000
HOST=localhost
CORS_ORIGIN=*

# ----------------------------------------------------------------------------
# Ollama Configuration (for Qwen LLM)
# ----------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=300000  # 5 minutes in milliseconds

# ----------------------------------------------------------------------------
# File Upload Configuration
# ----------------------------------------------------------------------------
UPLOAD_DIR=uploads
OUTPUT_DIR=output
MAX_FILE_SIZE=50000000  # 50MB in bytes
# Allowed types: image/jpeg, image/png, image/gif, image/webp

# ----------------------------------------------------------------------------
# Processing Configuration
# ----------------------------------------------------------------------------
ENABLE_PADDLE_OCR=true
ENABLE_TESSERACT=true
ENABLE_ZOOM_READS=true
ZOOM_READ_REGIONS_LIMIT=3  # Maximum number of zoom-read regions to process

# ============================================================================
# CONFIDENCE THRESHOLDS - HYBRID VALIDATION SYSTEM
# ============================================================================
# These thresholds control when Qwen LLM is invoked based on OCR quality
# Optimized for 98%/95%/93% accuracy targets

# ----------------------------------------------------------------------------
# Primary Confidence Levels (0.0 - 1.0 scale)
# ----------------------------------------------------------------------------

# EXCELLENT: 98%+ accuracy - Trust OCR completely, skip Qwen
# Requirements: High confidence + 98%+ char match + ≤2% word diff + no problem regions
CONFIDENCE_EXCELLENT=0.98

# HIGH: 95-98% accuracy - Invoke Qwen for validation (safety check)
# Good quality but invoke Qwen to ensure accuracy
CONFIDENCE_HIGH=0.95

# MEDIUM: 93-95% accuracy - Invoke Qwen with caution
# Moderate quality, Qwen validation needed
CONFIDENCE_MEDIUM=0.93

# LOW: <93% accuracy - Full Qwen treatment with zoom-reads
# Poor quality, requires comprehensive Qwen analysis
CONFIDENCE_LOW=0.93

# ----------------------------------------------------------------------------
# Character-Level Validation Thresholds
# ----------------------------------------------------------------------------

# Minimum character similarity required to skip Qwen (0.0 - 1.0)
# Uses Levenshtein distance to detect substitution errors
# Example: "quick" vs "quiet" = 89% similarity (below threshold)
CHAR_SIMILARITY_MIN=0.98  # 98%+ character match required for OCR-only

# Maximum word count discrepancy allowed (0.0 - 1.0, as percentage)
# Example: 0.02 = 2% difference allowed between PaddleOCR and Tesseract
WORD_DISCREPANCY_MAX=0.02  # Max 2% word count difference for OCR-only

# ----------------------------------------------------------------------------
# OCR Engine Agreement Thresholds
# ----------------------------------------------------------------------------

# Discrepancy warning level (0.0 - 1.0)
# OCR engines differ by less than this = trust results
DISCREPANCY_WARNING=0.05  # <5% difference = good agreement

# Discrepancy critical level (0.0 - 1.0)
# OCR engines differ by more than this = invoke Qwen as tiebreaker
DISCREPANCY_CRITICAL=0.07  # >7% difference = call Qwen

# ----------------------------------------------------------------------------
# Region-Level Quality Control
# ----------------------------------------------------------------------------

# Confidence threshold for flagging individual regions (0.0 - 1.0)
# Regions below this threshold are marked as "low confidence"
LOW_REGION_THRESHOLD=0.93  # Flag regions <93% confidence

# Maximum number of low-confidence regions before triggering zoom-reads
# More than this number = invoke Qwen with zoom-read mode
MAX_LOW_REGIONS=2  # >2 low-confidence regions = zoom-reads mode

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
LOG_LEVEL=info  # Options: error, warn, info, debug
LOG_FORMAT=default  # Options: default, json

# ============================================================================
# DECISION GATE BEHAVIOR SUMMARY
# ============================================================================
#
# GATE 1: EXCELLENT (≥98%)
#   Conditions: confidence ≥98% AND char_match ≥98% AND word_diff ≤2% AND
#               both_engines ≥98% AND no_problem_regions
#   Action: Skip Qwen (trust OCR)
#   Qwen Calls: 0
#
# GATE 2: HIGH (95-98%)
#   Conditions: confidence 95-98%
#   Action: Qwen validation
#   Qwen Calls: 1 (full-page)
#
# GATE 3: MEDIUM (93-95%)
#   Conditions: confidence 93-95%
#   Action: Qwen validation (caution mode)
#   Qwen Calls: 1 (full-page)
#
# GATE 4: LOW (<93%)
#   Conditions: confidence <93% OR >2 low-confidence regions OR engines disagree
#   Action: Full Qwen treatment with zoom-reads
#   Qwen Calls: 1-4 (1 full-page + up to 3 zoom-reads)
#
# GATE 5: CHAR SIMILARITY FALLBACK
#   Conditions: char_similarity <98% (OCR engines disagree)
#   Action: Qwen tiebreaker
#   Qwen Calls: 1 (full-page)
#
# ============================================================================
# TUNING RECOMMENDATIONS
# ============================================================================
#
# FOR MAXIMUM ACCURACY (99%+):
#   CONFIDENCE_EXCELLENT=0.99
#   CHAR_SIMILARITY_MIN=0.99
#   WORD_DISCREPANCY_MAX=0.01
#   (Warning: Will invoke Qwen more frequently, higher cost)
#
# FOR BALANCED ACCURACY (95%+) WITH LOWER COST:
#   CONFIDENCE_EXCELLENT=0.96
#   CHAR_SIMILARITY_MIN=0.95
#   WORD_DISCREPANCY_MAX=0.03
#   (Good balance between accuracy and LLM usage)
#
# FOR SPEED PRIORITY (90%+ accuracy acceptable):
#   CONFIDENCE_EXCELLENT=0.93
#   CHAR_SIMILARITY_MIN=0.93
#   WORD_DISCREPANCY_MAX=0.05
#   (Fewer Qwen calls, faster processing, lower accuracy)
#
# ============================================================================
# MONITORING METRICS TO TRACK
# ============================================================================
#
# 1. Qwen Invocation Rate: % of images that trigger Qwen
#    - Target with current settings: 40-60% (depending on image quality)
#    - Monitor: meta.qwen_invoked field in output JSON
#
# 2. Average Confidence Score: Overall OCR quality
#    - Target: ≥0.95 (95%+)
#    - Monitor: stage1_ocr.combined_confidence in output JSON
#
# 3. Character Similarity: Agreement between OCR engines
#    - Target: ≥0.98 (98%+)
#    - Monitor: stage1_ocr.alignment.char_similarity in output JSON
#
# 4. Processing Time: Total time per image
#    - OCR-only path: ~10-50ms
#    - Validation path: ~180-200ms (+1 Qwen call)
#    - Zoom-reads path: ~250-350ms (+1-4 Qwen calls)
#    - Monitor: meta.total_processing_time_ms in output JSON
#
# 5. Gate Distribution: Which gates are triggering
#    - Monitor: stage2_qwen.decision.gate_triggered in output JSON
#    - Adjust thresholds based on which gates fire most frequently
#
# ============================================================================
# Development/Testing
# ============================================================================
# Set to true to save debug images (cropped regions, etc)
DEBUG_SAVE_IMAGES=false

# Set to true to skip Qwen entirely (OCR only mode)
OCR_ONLY_MODE=false

# ============================================================================
# Notes
# ============================================================================
# 1. All thresholds are normalized 0.0-1.0 (0% to 100%)
# 2. All timeouts are in milliseconds
# 3. All file sizes are in bytes
# 4. Leave blank to use defaults shown above
# 5. Restart server after changing any values
# 6. Hybrid approach uses: 40% Paddle + 30% Tesseract + 30% CharSimilarity
# ============================================================================
